APP_NAME=Forex Trading Analyst
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://forex_dev:changeme@localhost:5432/forex_analyst_dev
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379/0
TWELVE_DATA_API_KEY=changeme-get-a-free-key-from-twelvedata.com
TWELVE_DATA_REST_URL=https://api.twelvedata.com
TWELVE_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price
MARKET_INSTRUMENTS=["EUR/USD","GBP/USD","USD/JPY","USD/CHF","AUD/USD","USD/CAD","NZD/USD","XAU/USD"]
MODEL_STORAGE_PATH=./models
EXECUTION_ENABLED=false
EXECUTION_MAX_POSITION_SIZE=10000
EXECUTION_MAX_OPEN_POSITIONS=3
EXECUTION_MAX_DAILY_LOSS_PCT=5.0